# BootLog environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Supabase (required) ---
# Database/persistence. Get these from your Supabase project settings > API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Google Maps (optional) ---
# Browser-only Maps JavaScript API key. HTTP-referrer restricted.
# Baked into the frontend bundle at build time (VITE_ prefix).
VITE_GOOGLE_MAPS_KEY=your-maps-browser-key

# --- Stripe (optional) ---
# Server-side secret key for payment processing.
STRIPE_SECRET_KEY=sk_live_or_test_key

# --- Mobile field-enforcer preview (optional) ---
# Both must be "1" to enable the isolated enforcer mobile preview route.
VITE_ENABLE_ENFORCER_MOBILE_PREVIEW=1
ENABLE_ENFORCER_MOBILE_PREVIEW=1

# --- Server (set automatically by host; default 5000 locally) ---
# PORT=5000
