{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install",
  "outputDirectory": "dist/public",
  "functions": {
    "api/[[...path]].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/((?!api/|assets/|favicon).*)", "destination": "/index.html" }
  ]
}
